# Скопируй в .env и заполни. Ключи ИИ (apibost) — те же, что у wgpt_bot.
PUBLIC_URL=https://mystorybook.site
PRICE_RUB=1490.00

AI_BASE_URL=
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# MYSTORY_AI_MODEL=gpt-4o-mini            # уточняющие вопросы — быстрая модель
# MYSTORY_AI_CHAPTER_MODEL=claude-sonnet-4-6  # литературный текст глав
AI_TIMEOUT_SECONDS=90
AI_MAX_CONCURRENT=4

# Оплата: Lava — ключи добавим при подключении.

# Админка на скрытом адресе: https://mystorybook.site/<ADMIN_PATH>. Пароль — от 12 символов.
ADMIN_PATH=
ADMIN_PASSWORD=

# Алерты, сводка и бэкапы в Telegram. Подключение чата: https://t.me/<бот>?start=<TG_LINK_CODE>
TG_BOT_TOKEN=
TG_LINK_CODE=
# chat_id через запятую (нужно для внешнего сторожа scripts/watchdog.sh)
TG_ADMIN_CHAT_IDS=
