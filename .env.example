# Скопируй в .env и заполни. Ключи ИИ (apibost) и UrlPay — те же, что у wgpt_bot.
PUBLIC_URL=https://mystorybook.site
# docker-сеть общего nginx (проект wgpt_bot)
EDGE_NETWORK=wgpt_bot_internal
PRICE_RUB=1490.00

AI_BASE_URL=
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# MYSTORY_AI_MODEL=   # своя модель для книги, если нужна отдельная от донора
AI_TIMEOUT_SECONDS=90
AI_MAX_CONCURRENT=4

URLPAY_API_KEY=
URLPAY_SECRET_KEY=
URLPAY_SHOP_ID=
